CREATE TABLE RouteState (
    id INTEGER NOT NULL PRIMARY KEY,
    description TEXT NOT NULL
);

INSERT INTO RouteState (id, description) VALUES (1, 'BORRADOR');
INSERT INTO RouteState (id, description) VALUES (2, 'EN EJECUCIÓN');
INSERT INTO RouteState (id, description) VALUES (3, 'FINALIZADA');

selectAll:
SELECT * FROM RouteState;

selectById:
SELECT * FROM RouteState WHERE id = :id;