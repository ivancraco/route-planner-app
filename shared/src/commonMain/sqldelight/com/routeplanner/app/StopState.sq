selectAll:
SELECT * FROM StopState;

upsert:
INSERT OR REPLACE INTO StopState (id, description)
VALUES (:id, :description);

deleteById:
DELETE FROM StopState WHERE id = :id;

deleteAll:
DELETE FROM StopState;